# Production Environment Variables (Vercel)
# These will be overridden by Vercel environment variables

VITE_USE_MOCK=false
VITE_API_BASE_URL=https://your-backend-url.onrender.com/api

# Replace 'your-backend-url' with your actual Render backend URL after deployment
# Example: VITE_API_BASE_URL=https://udcp-backend-abc123.onrender.com/api
